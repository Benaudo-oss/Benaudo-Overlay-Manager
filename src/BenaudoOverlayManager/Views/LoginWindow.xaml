<Window x:Class="BenaudoOverlayManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion — Benaudo Overlay Manager" Width="1120" Height="700"
        MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width=".88*"/></Grid.ColumnDefinitions>
    <Grid Background="#080C13" ClipToBounds="True">
      <Rectangle>
        <Rectangle.Fill><RadialGradientBrush Center=".26,.42" GradientOrigin=".26,.42" RadiusX=".78" RadiusY=".78">
          <GradientStop Color="#3A006DFF" Offset="0"/><GradientStop Color="#120A2B5A" Offset=".48"/><GradientStop Color="#00090D14" Offset="1"/>
        </RadialGradientBrush></Rectangle.Fill>
      </Rectangle>
      <Canvas IsHitTestVisible="False" Opacity=".28">
        <Path Stroke="#168BFF" StrokeThickness="1" Data="M -40,570 L 160,370 L 260,405 L 420,220 L 610,255"/>
        <Path Stroke="#54D8FF" StrokeThickness="2" Data="M 60,620 L 235,440 L 208,400 L 360,332 L 335,280 L 540,80"/>
        <Path Stroke="#168BFF" StrokeThickness="5" Opacity=".45" Data="M 205,640 L 314,485 L 290,445 L 415,360 L 388,312 L 560,100">
          <Path.Effect><BlurEffect Radius="18"/></Path.Effect>
        </Path>
        <Path Stroke="#FF2438" StrokeThickness="2" Opacity=".65" Data="M 0,655 L 170,620 L 194,570"/>
      </Canvas>
      <Grid Margin="58,48,46,50">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="44" Height="44" CornerRadius="10" Background="#151F2E" BorderBrush="#3B54D8FF" BorderThickness="1">
            <Path Stretch="Uniform" Margin="10" Fill="#54D8FF" Data="M12,0 L3,13 H10 L7,24 L21,9 H14 L18,0 Z"/>
          </Border>
          <StackPanel Margin="13,2,0,0"><TextBlock Text="BENAUDO" FontSize="21" FontWeight="Black"/>
            <TextBlock Text="OVERLAY MANAGER" FontSize="10" Foreground="{StaticResource ElectricLightBrush}" FontWeight="Bold"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
          <Border HorizontalAlignment="Left" Background="#22168BFF" CornerRadius="12" Padding="12,6" Margin="0,0,0,20">
            <TextBlock Text="CONÇU POUR iRACING" Foreground="{StaticResource ElectricLightBrush}" FontSize="11" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="VOTRE COURSE.&#10;VOS INFORMATIONS.&#10;VOTRE AVANTAGE." FontSize="42" FontWeight="Black" LineHeight="48"/>
          <Rectangle Width="86" Height="4" HorizontalAlignment="Left" Margin="0,23,0,21" Fill="{StaticResource RacingBrush}"/>
          <TextBlock Text="Des overlays précis, fluides et entièrement configurables, pensés pour rester discrets sur les ressources de votre PC." TextWrapping="Wrap" FontSize="15" LineHeight="24" Foreground="{StaticResource MutedBrush}" MaxWidth="475" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="{StaticResource ElectricLightBrush}" Margin="0,0,9,0"/>
          <TextBlock Text="Télémétrie locale • Aucun enregistrement automatique" Foreground="#71879E" FontSize="11"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Grid Grid.Column="1" Background="#0D131D">
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Width="46" Height="42" Content="―" FontSize="14" Foreground="#AABACA" Background="Transparent" BorderThickness="0" Click="Minimize_Click"/>
        <Button Width="46" Height="42" Content="×" FontSize="20" Foreground="#AABACA" Background="Transparent" BorderThickness="0" Click="Close_Click"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid Margin="68,45,68,30" MaxWidth="410"><StackPanel VerticalAlignment="Center">
          <TextBlock Text="BON RETOUR" FontSize="28" FontWeight="Bold"/>
          <TextBlock Text="Connectez-vous pour accéder à vos overlays." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,31"/>
          <TextBlock Text="ADRESSE E-MAIL" FontSize="11" FontWeight="Bold" Foreground="#B9C9D9" Margin="0,0,0,8"/>
          <TextBox x:Name="EmailBox" Style="{StaticResource FieldStyle}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Adresse e-mail"/>
          <TextBlock Text="MOT DE PASSE" FontSize="11" FontWeight="Bold" Foreground="#B9C9D9" Margin="0,21,0,8"/>
          <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordStyle}" PasswordChanged="PasswordBox_PasswordChanged" AutomationProperties.Name="Mot de passe"/>
          <Grid Margin="0,15,0,23"><CheckBox Content="Rester connecté" IsChecked="{Binding RememberSession}" Foreground="#B7C6D5" VerticalAlignment="Center"/>
            <Button Content="Mot de passe oublié ?" HorizontalAlignment="Right" Foreground="{StaticResource ElectricLightBrush}" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ForgotPassword_Click"/></Grid>
          <Border Background="#24FF2438" BorderBrush="#65FF2438" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,15" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF9BA5" TextWrapping="Wrap" FontSize="12"/></Border>
          <Button x:Name="SignInButton" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SignInCommand}" CommandParameter="{Binding ElementName=PasswordBox, Path=Password}" IsDefault="True">
            <Grid><TextBlock Text="SE CONNECTER" Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
              <TextBlock Text="CONNEXION…" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid>
          </Button>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
            <TextBlock Text="Pas encore de compte ?" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <Button Content="Créer un compte" Foreground="{StaticResource ElectricLightBrush}" FontWeight="Bold" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" Click="CreateAccount_Click"/>
          </StackPanel>
        </StackPanel></Grid>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Text="© 2026 Benaudo • Confidentialité • Conditions" HorizontalAlignment="Center" Foreground="#5F7388" FontSize="10" Margin="0,0,0,22"/>
    </Grid>
  </Grid>
</Window>
